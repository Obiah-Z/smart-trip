# Public web port exposed by docker compose.
WEB_PORT=8080

# For same-origin deployment through nginx, keep this empty.
VITE_API_BASE=

# Set this to your public origin(s), comma-separated.
# Examples:
# CORS_ALLOWED_ORIGINS=https://trip.example.com
# CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP:8080,https://trip.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Main model provider. Keep secrets out of git and replace values only on the server.
OPENAI_MODE=openai
OPENAI_BASE_URL=https://hub.tokenpanda.top/v1
OPENAI_API_KEY=replace_with_your_deepseek_api_key
OPENAI_MODEL=deepseek-v4-pro

# RAG configuration. Local/hybrid mode uses the indexes under backend/data/rag/index.
RAG_MODE=local
RAG_INDEX_PATH=/app/backend/data/rag/index/rag_index.json
EMBEDDING_MODE=disabled
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=0
EMBEDDING_INDEX_PATH=/app/backend/data/rag/index/embedding_index.json
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TRUST_ENV=true

# Image generation. Disabled by default for public demo stability.
IMAGE_MODE=disabled
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_OUTPUT_DIR=/app/backend/data/generated_images/kolors
IMAGE_DEFAULT_SIZE=1536x1024
IMAGE_DEFAULT_QUALITY=medium
IMAGE_DEFAULT_FORMAT=jpeg
IMAGE_DEFAULT_COMPRESSION=85
IMAGE_MODERATION=auto
IMAGE_TIMEOUT_SECONDS=120
IMAGE_ENABLE_CACHE=true

# Map configuration. Use amap when AMap keys are configured; switch to local_preview only for offline demos.
MAP_PROVIDER=amap
AMAP_WEB_SERVICE_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SECONDS=20
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_JSCODE=
VITE_MAP_PROVIDER=amap

# Knowledge graph.
KNOWLEDGE_GRAPH_ENABLED=true
KNOWLEDGE_GRAPH_VAULT_DIR=/app/backend/data/knowledge_graph/obsidian_vault
