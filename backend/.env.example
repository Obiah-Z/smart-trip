OPENAI_MODE=mock
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-me
OPENAI_MODEL=deepseek-v4-pro
RAG_MODE=local
RAG_INDEX_PATH=/absolute/path/to/backend/data/rag/index/rag_index.json
EMBEDDING_MODE=disabled
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=0
EMBEDDING_INDEX_PATH=/absolute/path/to/backend/data/rag/index/embedding_index.json
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TRUST_ENV=true

# -----------------------------
# Image Generation
# -----------------------------
IMAGE_MODE=openai_compatible
IMAGE_BASE_URL=https://api.v3.cm/v1
IMAGE_API_KEY=replace-with-your-image-key
IMAGE_MODEL=Kolors
IMAGE_OUTPUT_DIR=/absolute/path/to/backend/data/generated_images/kolors
IMAGE_DEFAULT_SIZE=1024x1024
IMAGE_DEFAULT_QUALITY=medium
IMAGE_DEFAULT_FORMAT=jpeg
IMAGE_DEFAULT_COMPRESSION=85
IMAGE_MODERATION=auto
IMAGE_TIMEOUT_SECONDS=120
IMAGE_ENABLE_CACHE=true
